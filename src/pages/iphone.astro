---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import iosS from "../assets/ios-ş.png";
import iosO from "../assets/ios-ö.png";
import iosC from "../assets/ios-ç.png";
import iosG from "../assets/ios-ğ.png";

import "swiper/css";
import "swiper/css/pagination";
import "swiper/css/autoplay";

const images = [
  { src: iosS, alt: "iOS klaviaturasi: Ş harfi" },
  { src: iosO, alt: "iOS klaviaturasi: Ö harfi" },
  { src: iosC, alt: "iOS klaviaturasi: Ç harfi" },
  { src: iosG, alt: "iOS klaviaturasi: Ğ harfi" },
];
---

<Layout
  title="iPhone klaviaturasi | Yangi alifbodagi Ş, Ç, Ö va Ğ harflarini kiritish"
  description="iPhoneʼda yangi alifbodagi Ş, Ç, Ö va Ğ harflarini iPhone klaviaturasi yordamida kiriting."
>
  <div class="mx-auto flex max-w-4xl flex-col items-center px-4 py-10 md:py-16 gap-8">
    <!-- Header Section -->
    <div class="text-center max-w-2xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs md:text-sm font-semibold tracking-wide">
        <span> iOS / iPhone Keyboard</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">
        iPhone klaviaturasi
      </h1>
      <p class="text-base md:text-lg text-base-content/80 leading-relaxed">
        iPhone va iPad qurilmalarida qöşimça ilova örnatmasdan{" "}
        <strong class="text-base-content font-semibold">Ş, Ö, Ç va Ğ</strong>{" "}
        harflarini töğridan-töğri kiritiş imkoni mavjud.
      </p>
    </div>

    <!-- Carousel Showcase Container -->
    <div class="w-full bg-base-200/50 border border-base-300/60 rounded-3xl p-6 md:p-8 flex flex-col items-center shadow-xs">
      <div class="swiper mySwiper rounded-2xl w-full max-w-sm">
        <div class="swiper-wrapper">
          {images.map((img) => (
            <div class="swiper-slide flex justify-center">
              <Image
                src={img.src}
                alt={img.alt}
                class="rounded-2xl h-72 md:h-96 w-auto object-contain shadow-md"
              />
            </div>
          ))}
        </div>
        <div class="swiper-pagination mt-4"></div>
      </div>
    </div>

    <!-- Instructions Grid Section -->
    <div class="w-full max-w-2xl bg-base-200/40 border border-base-300/50 rounded-2xl p-6 md:p-8 space-y-6 shadow-xs">
      <h2 class="text-xl md:text-2xl font-bold text-center">
        Harflarni qanday kiritiş mumkin?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-base-100 p-4 rounded-xl border border-base-300/60 flex items-start gap-3 shadow-xs">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary/10 text-primary font-bold shrink-0">
            Ş
          </span>
          <div>
            <h3 class="font-semibold text-sm md:text-base">Ş harfi</h3>
            <p class="text-xs md:text-sm text-base-content/70 mt-1">
              <kbd class="kbd kbd-sm">S</kbd> tugmasini bosib turing va tanlang.
            </p>
          </div>
        </div>

        <div class="bg-base-100 p-4 rounded-xl border border-base-300/60 flex items-start gap-3 shadow-xs">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary/10 text-primary font-bold shrink-0">
            Ö
          </span>
          <div>
            <h3 class="font-semibold text-sm md:text-base">Ö harfi</h3>
            <p class="text-xs md:text-sm text-base-content/70 mt-1">
              <kbd class="kbd kbd-sm">O</kbd> tugmasini bosib turing va tanlang.
            </p>
          </div>
        </div>

        <div class="bg-base-100 p-4 rounded-xl border border-base-300/60 flex items-start gap-3 shadow-xs">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary/10 text-primary font-bold shrink-0">
            Ç
          </span>
          <div>
            <h3 class="font-semibold text-sm md:text-base">Ç harfi</h3>
            <p class="text-xs md:text-sm text-base-content/70 mt-1">
              <kbd class="kbd kbd-sm">C</kbd> tugmasini bosib turing va tanlang.
            </p>
          </div>
        </div>

        <div class="bg-base-100 p-4 rounded-xl border border-base-300/60 flex items-start gap-3 shadow-xs">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary/10 text-primary font-bold shrink-0">
            Ğ
          </span>
          <div>
            <h3 class="font-semibold text-sm md:text-base">Ğ harfi</h3>
            <p class="text-xs md:text-sm text-base-content/70 mt-1">
              <kbd class="kbd kbd-sm">G</kbd> tugmasini bosib turing va tanlang.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-primary/5 border border-primary/20 rounded-xl p-4 text-center text-xs md:text-sm text-base-content/80">
        💡 <b>Eslatma:</b> Ushbu usul standart iOS klaviaturasida örnatilgan
        holatda işlaydi, heç qanday qöşimça ilova yuklab oliş talab etilmaydi!
      </div>
    </div>
  </div>
</Layout>

<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination } from "swiper/modules";

  document.addEventListener("DOMContentLoaded", () => {
    new Swiper(".mySwiper", {
      modules: [Autoplay, Pagination],
      loop: true,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
    });
  });
</script>
