---
import Layout from "../layouts/Layout.astro";
import { Download, CheckCircle2 } from "@lucide/astro";
import { Image } from "astro:assets";
import macosLayout from "../assets/macos-keyboard-layout.png";
import macos1 from "../assets/macos-1.png";
import macos2 from "../assets/macos-2.png";
import macos3 from "../assets/macos-3.png";
import macos4 from "../assets/macos-4.png";
import macos5 from "../assets/macos-5.png";
import macos6 from "../assets/macos-6.png";
---

<Layout
  title="macOS uchun yangi oʻzbek alifbo klaviaturasini yuklab olish | Ş, Ç, Ö va Ğ harflarini kiritish"
  description="macOS operatsion tizimida yangi alifbodagi Ş, Ç, Ö va Ğ harflarini kiritish uchun klaviaturani yuklab oling."
>
  <div class="mx-auto flex max-w-5xl flex-col items-center px-4 py-10 md:py-16 gap-10">
    <!-- Hero Header & Preview -->
    <div class="text-center max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs md:text-sm font-semibold tracking-wide">
        <span>macOS (Apple Silicon & Intel)</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight">
        macOS uchun klaviatura
      </h1>
      <p class="text-base md:text-lg text-base-content/80 leading-relaxed">
        macOS operatsion tizimida{" "}
        <strong class="text-base-content font-semibold">Ş, Ç, Ö, Ğ</strong>{" "}
        harflarini qulay va tez kiritish uchun tayyor klaviatura terilmasi.
      </p>
    </div>

    <!-- Keyboard Layout Image & Primary Download Button -->
    <div class="w-full bg-base-200/50 border border-base-300/60 rounded-3xl p-6 md:p-8 flex flex-col items-center shadow-xs gap-6">
      <Image
        src={macosLayout}
        alt="macOS klaviatura terilmasi"
        class="rounded-xl shadow-md max-w-full h-auto"
      />

      <a
        class="btn btn-lg btn-primary btn-wide rounded-2xl gap-2 shadow-md hover:shadow-lg transition-all"
        href="/ozbekcha-yangi-alifbo.keylayout"
        download="ozbekcha-yangi-alifbo.keylayout"
      >
        <Download class="h-6 w-6" />
        <span>Yuklab olish</span>
      </a>
    </div>

    <!-- Features Overview Section -->
    <div class="w-full space-y-4">
      <h2 class="text-2xl font-bold text-center md:text-left">
        Klaviatura xususiyatlari
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-base-200/50 border border-base-300/60 p-5 rounded-2xl space-y-2">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
            <CheckCircle2 class="w-5 h-5" />
          </div>
          <h3 class="font-semibold text-lg">Rasmiy standart</h3>
          <p class="text-sm text-base-content/70 leading-relaxed">
            Yirik texnologik kompaniyalarga rasmiy taklif sifatida yuborilgan.
            Hozirdanoq oʻrganib olsangiz, tez orada operatsion tizimlarga rasmiy
            yangilanish kelganda koʻnikish shart boʻlmaydi.
          </p>
        </div>

        <div class="bg-base-200/50 border border-base-300/60 p-5 rounded-2xl space-y-2">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
            <kbd class="kbd kbd-sm">Q</kbd>
          </div>
          <h3 class="font-semibold text-lg">Standard QWERTY</h3>
          <p class="text-sm text-base-content/70 leading-relaxed">
            Standart QWERTY terilmasiga asoslangan boʻlib, oʻrganish juda oson
            va tez kechadi. SIL Ukelele dasturida yaratilgan.
          </p>
        </div>

        <div class="bg-base-200/50 border border-base-300/60 p-5 rounded-2xl space-y-2">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
            <kbd class="kbd kbd-sm">Opt</kbd>
          </div>
          <h3 class="font-semibold text-lg">Oson kiritish</h3>
          <p class="text-sm text-base-content/70 leading-relaxed">
            Harflarni yozishda <kbd class="kbd kbd-xs">Option</kbd> bosish talab
            etilmaydi. Qoʻshimcha belgilar uchun{" "}
            <kbd class="kbd kbd-xs">Option</kbd> ishlatiladi.
          </p>
        </div>
      </div>
    </div>

    <!-- Key Shortcuts & Combinations Section -->
    <div class="w-full space-y-6">
      <h2 class="text-2xl font-bold text-center md:text-left">
        Tugmalar birikmasi
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Direct Characters Table -->
        <div class="bg-base-200/40 border border-base-300/60 rounded-2xl p-5 space-y-3">
          <h3 class="font-semibold text-lg text-primary flex items-center gap-2">
            <span>🔤 Yangi harflar</span>
          </h3>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Harf</th>
                  <th>Bosiladigan tugma</th>
                </tr>
              </thead>
              <tbody class="text-sm">
                <tr>
                  <td>
                    <b>ş harfi</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">;</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>ç harfi</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">'</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>ö harfi</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">[</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>ğ harfi</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">]</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>Tutuq belgisi (ʼ)</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">\</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>ʻOkina belgisi (ʻ)</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">\</kbd>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Option Special Symbols Table -->
        <div class="bg-base-200/40 border border-base-300/60 rounded-2xl p-5 space-y-3">
          <h3 class="font-semibold text-lg text-primary flex items-center gap-2">
            <span>⌨️ Qoʻshimcha belgilar (Option bilan)</span>
          </h3>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Belgi</th>
                  <th>Kombinatsiya</th>
                </tr>
              </thead>
              <tbody class="text-sm">
                <tr>
                  <td>
                    Nuqta vergul <b>;</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">Option</kbd> +{" "}
                    <kbd class="kbd kbd-sm">;</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    Ikki nuqta <b>:</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">Option</kbd> +{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">;</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    Apostrof <b>'</b> / Qoʻshtirnoq <b>"</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">Option</kbd> +{" "}
                    <kbd class="kbd kbd-sm">'</kbd> /{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    Qavslar <b>[ ]</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">Option</kbd> +{" "}
                    <kbd class="kbd kbd-sm">[</kbd> yoki{" "}
                    <kbd class="kbd kbd-sm">]</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    Figurali qavslar <b>&#123; &#125;</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">Option</kbd> +{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">[</kbd> /{" "}
                    <kbd class="kbd kbd-sm">]</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    Slesh <b>\</b> / Tik chiziq <b>|</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">Option</kbd> +{" "}
                    <kbd class="kbd kbd-sm">\</kbd> /{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Installation Steps Section -->
    <div class="w-full bg-base-200/40 border border-base-300/60 rounded-3xl p-6 md:p-8 space-y-6 shadow-xs">
      <h2 class="text-2xl font-bold text-center md:text-left">
        Oʻrnatish usuli
      </h2>

      <ol class="space-y-6">
        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            1
          </span>
          <div class="space-y-1">
            <h3 class="font-semibold text-base md:text-lg">
              Faylni yuklab oling
            </h3>
            <p class="text-sm text-base-content/80">
              <a
                href="/ozbekcha-yangi-alifbo.keylayout"
                download="ozbekcha-yangi-alifbo.keylayout"
                class="link link-primary font-mono font-semibold"
              >
                ozbekcha-yangi-alifbo.keylayout
              </a>{" "}
              faylini yuklab oling.
            </p>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            2
          </span>
          <div class="space-y-1">
            <h3 class="font-semibold text-base md:text-lg">
              Klaviatura papkasiga koʻchiring
            </h3>
            <p class="text-sm text-base-content/80">
              Finder ilovasida <kbd class="kbd">Command</kbd> +{" "}
              <kbd class="kbd">Shift</kbd> + <kbd class="kbd">G</kbd>{" "}
              tugmalarini bosing va ochilgan oynaga{" "}
              <span class="font-mono bg-base-300/60 px-2 py-0.5 rounded text-xs">
                ~/Library/Keyboard Layouts
              </span>{" "}
              manzilini kiriting, soʻngra yuklab olingan faylni shu papkaga
              joylashtiring.
            </p>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            3
          </span>
          <div class="space-y-1">
            <h3 class="font-semibold text-base md:text-lg">
              Tizim Sozlamalarini oching
            </h3>
            <p class="text-sm text-base-content/80">
              Mac sozlamalaridan <b>Keyboard</b> (Klaviatura) boʻlimiga oʻting.
            </p>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            4
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Input Sources sozlamasiga oʻting
            </h3>
            <p class="text-sm text-base-content/80">
              Input sources boʻlimidagi <b>Edit...</b> tugmasini bosing.
            </p>
            <div class="flex justify-center pt-2">
              <Image
                src={macos1}
                alt="MacOS settings"
                class="rounded-xl border border-base-300 shadow-sm max-w-md w-full"
              />
            </div>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            5
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Yangi til qoʻshish tugmasini bosing
            </h3>
            <p class="text-sm text-base-content/80">
              Pastdagi chap tarafdagi <b>“+”</b> tugmasini bosing.
            </p>
            <div class="flex justify-center pt-2">
              <Image
                src={macos2}
                alt="MacOS Input Sources"
                class="rounded-xl border border-base-300 shadow-sm max-w-md w-full"
              />
            </div>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            6
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Others boʻlimini tanlang
            </h3>
            <p class="text-sm text-base-content/80">
              Tillar roʻyxatining eng pastiga tushing va <b>Others</b>{" "}
              opsiyasini tanlang.
            </p>
            <div class="flex justify-center pt-2">
              <Image
                src={macos3}
                alt="MacOS browse input sources"
                class="rounded-xl border border-base-300 shadow-sm max-w-md w-full"
              />
            </div>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            7
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Özbekça — Yangi alifbo ni tanlang
            </h3>
            <p class="text-sm text-base-content/80">
              Oʻng tarafdagi menyudan <b>Özbekça — Yangi alifbo</b> opsiyasini
              topib tanlang va <b>Add</b> tugmasini bosing.
            </p>
            <div class="flex justify-center pt-2">
              <Image
                src={macos4}
                alt="MacOS browse input sources 2"
                class="rounded-xl border border-base-300 shadow-sm max-w-md w-full"
              />
            </div>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            8
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Oʻrnatishni yakunlang
            </h3>
            <p class="text-sm text-base-content/80">
              <b>Done</b> tugmasini bosib sozlamalarni saqlang.
            </p>
            <div class="flex justify-center pt-2">
              <Image
                src={macos5}
                alt="MacOS Input Sources 2"
                class="rounded-xl border border-base-300 shadow-sm max-w-md w-full"
              />
            </div>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            9
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Klaviaturadan foydalana boshlang
            </h3>
            <p class="text-sm text-base-content/80">
              MacOS til tanlash menyusidan <b>Özbekça — Yangi alifbo</b>{" "}
              opsiyasini tanlab bemalol yozishingiz mumkin.
            </p>
            <div class="flex justify-center pt-2">
              <Image
                src={macos6}
                alt="MacOS language select menu"
                class="rounded-xl border border-base-300 shadow-sm max-w-md w-full"
              />
            </div>
          </div>
        </li>
      </ol>
    </div>

    <!-- Bottom Secondary Download Callout -->
    <div class="text-center pt-4">
      <a
        class="btn btn-lg btn-primary btn-wide rounded-2xl gap-2 shadow-md hover:shadow-lg transition-all"
        href="/ozbekcha-yangi-alifbo.keylayout"
        download="ozbekcha-yangi-alifbo.keylayout"
      >
        <Download class="h-6 w-6" />
        <span>Yuklab olish</span>
      </a>
    </div>
  </div>
</Layout>
