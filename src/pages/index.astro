---
import Layout from "../layouts/Layout.astro";
import windowsLogo from "../assets/windows11.svg?raw";
import androidLogo from "../assets/android.svg?raw";
import linuxLogo from "../assets/linux-mono.svg?raw";
import samsungLogo from "../assets/samsung.svg?raw";
import macosLogo from "../assets/macos.svg?raw";
import iosLogo from "../assets/iphone.svg?raw";

const cards = [
  { logo: windowsLogo, text: "Windows", link: "/windows/" },
  { logo: linuxLogo, text: "Linux", link: "/linux/" },
  { logo: macosLogo, text: "macOS", link: "/macos/" },
  { logo: samsungLogo, text: "Samsung", link: "/samsung/" },
  { logo: androidLogo, text: "Android", link: "/android/" },
  { logo: iosLogo, text: "iPhone", link: "/ios/" },
];

const faqs = [
  {
    q: "Redmi, Xiaomi, LG va boshqa telefonlarida yangi harflarni qanday kiritaman?",
    a_html: `Iltimos, <a href="/android/" class="link link-primary">Android uchun qoʻllanmaga</a> murojaat qiling.`,
  },
  {
    q: "Telefon uchun yuklash uchun klaviatura fayli yoʻq-ku!",
    a_html: `
          <p class="mb-3"><b>Ha, toʻgʻri.</b> Hozircha smartfonlar (Android va iOS) uchun alohida ilova yoki fayl koʻrinishidagi oʻzbekcha klaviatura ishlab chiqilmagan. Lekin yangi harflarni kiritishning juda oson yoʻli bor:</p>

          <div class="bg-base-300/50 p-3.5 rounded-lg border-l-4 border-primary mb-3 text-sm md:text-base">
            <b>Qanday yoziladi?</b> Telefoningizdagi standart klaviaturada <b>S, C, O, G</b> tugmalarini bir soniya bosib tursangiz, ustida mos ravishda <b>Ş, Ç, Ö, Ğ</b> harflari chiqadi. Ulardan keraklisini tanlasangiz bas.
          </div>

          <div class="bg-warning/10 text-warning-content p-3.5 rounded-lg border border-warning/30 text-sm">
            <p class="font-semibold mb-1 flex items-center gap-1.5">
              ⚠️ Muhim xavfsizlik ogohlantirishi:
            </p>
            <p>Telegram yoki turli saytlarda tarqalayotgan nomaʼlum <b>.APK</b> fayllarni telefoningizga oʻrnatmang! Firibgarlar bunday fayllar ichiga maxfiy maʼlumotlar va parollarni oʻgʻirlovchi zararli dasturlarni joylashtirgan boʻlishi mumkin. Ogoh boʻling.</p>
          </div>
        `,
  },
  {
    q: "Buning oʻrniga Turkcha yoki Ozarbayjoncha klaviatura ishlatsam boʻladi-ku! Bu nega yomon gʻoya?",
    a_html: `
          <p class="mb-3">Turkcha va Ozarbayjoncha klaviaturalarda rostdan ham <b>Ş, Ç, Ö, Ğ</b> harflari bor, lekin ulardan foydalanish juda katta muammolarni keltirib chiqaradi:</p>
          <ul class="list-disc list-inside space-y-2 mb-3 pl-1">
            <li><b>Nuqtali va nuqtasiz "I" muammosi:</b> Turk va ozarbayjon alifbosida ikkita har xil I harfi bor: nuqtali <code>İ / i</code> hamda nuqtasiz <code>I / ı</code>. Oʻzbek tilida esa oddiy <code>I / i</code> ishlatiladi. Turkcha klaviaturada yozsangiz, matningizda oʻzbek tiliga mos kelmaydigan <i>"İkki"</i> yoki <i>"kısh"</i> kabi soʻzlar paydo boʻladi.</li>
            <li><b>Qidiruv tizimlari (SEO) xatoliklari:</b> Kompyuter uchun bu harflarning raqamli kodi (Unicode) mutlaqo boshqa. Turkcha klaviaturada yozilgan matnlarni Google, Telegram va qidiruv tizimlari oʻzbekcha soʻz deb topa olmaydi.</li>
            <li><b>Hujjatlar va dasturlash:</b> Rasmiy davlat tizimlari (pasport, bank, soliq) turkcha <code>İ</code> va <code>ı</code> harflarini nomaʼlum belgi yoki xatolik deb qabul qiladi.</li>
          </ul>
          <p>Shuning uchun turkcha yoki ozarbayjoncha emas, aynan oʻzbek tili uchun moslashtirilgan klaviatura terilmasidan foydalanish zarur.</p>
        `,
  },
  {
    q: "Bu programma xavfsizmi?",
    a_html: `
          <p class="mb-3">Ha, veb-saytdan klaviatura fayllarini yuklab olish <b>100% xavfsiz</b>. Buning bir nechta asosiy sabablari bor:</p>
          <ul class="list-disc list-inside space-y-2 mb-3 pl-1">
            <li><b>Ochiq kod (Open Source):</b> Veb-sayt va klaviatura fayllarining barcha kodlari <a href="https://github.com" target="_blank" class="link link-primary">GitHub</a> saytida ochiq joylangan. Xohlagan kishi kodlarni tekshirib chiqishi mumkin — u yerda hech qanday maxfiy maʼlumotlarni yigʻuvchi zararli kodlar yoʻq.</li>
            <li><b>Rasmiy vositalardan foydalanilgan:</b> Klaviatura fayllari Windows uchun rasmiy <i>Microsoft Keyboard Layout Creator (MSKLC)</i> va macOS uchun <i>Ukelele</i> dasturlari yordamida yaratilgan. Ular tizimga hech qanday begona dastur oʻrnatmaydi, faqatgina tugmalarning joylashuv tartibini belgilaydi.</li>
            <li><b>Har kim oʻzi tekshira oladi:</b> Agar shunda ham xavotiringiz boʻlsa, tayyor faylni yuklamasdan, ushbu rasmiy dasturlar (MSKLC/Ukelele) orqali oʻzingiz ham 5 daqiqada xuddi shunday klaviatura terilmasini yasab olishingiz mumkin.</li>
          </ul>
        `,
  },
  {
    q: "Yangi alifbo rasman qabul qilindimi?",
    a_html: `
          <p class="mb-3"><b>Ha, rasman qabul qilingan.</b> Oʻzbekiston Respublikasi Prezidenti Sh. Mirziyoyev 2026-yil 21-oktyabr kuni yangi alifbo haqidagi tuzatishlar kiritilgan qonunni imzoladi.</p>

          <div class="bg-base-300/50 p-3.5 rounded-lg border-l-4 border-primary mb-3 text-sm md:text-base">
            <b>Qachondan kuchga kiradi?</b> Qonun rasman eʼlon qilinganidan soʻng <b>60 kun oʻtgach</b> toʻliq kuchga kiradi.
          </div>

          <p class="text-sm text-base-content/80">
            Hozirda davlat idoralari, taʼlim muassasalari va raqamli platformalar bosqichma-bosqich ushbu yangi alifboga oʻtish ishlarini olib bormoqda. Kompyuter va telefonlarda ushbu klaviatura terilmalarini hozirdanoq oʻrnatib olish yangi harflarga koʻnikish va qulay yozish imkonini beradi.
          </p>
        `,
  },
  {
    q: "Yangi harflar nimaga aynan ushbu joyda joylashgan?",
    a_html: `
          <p class="mb-3">Bu klaviatura terilmasi (layout) tasodifiy tuzilmagan — u <b>ergonomika</b>, <b>amaliy qulaylik</b> va <b>xalqaro standartlar</b> asosida ishlab chiqilgan:</p>

          <ul class="list-disc list-inside space-y-2 mb-3 pl-1">
            <li><b>Rasmiy taklifga asoslangan:</b> Ushbu terilma Microsoft, Google, Apple va Linux kabi yirik texnologik kompaniyalarga operatsion tizimlariga rasmiy kiritish uchun yuborilgan standart taklif asosida yaratilgan.</li>
            <li><b>Kelajak uchun qulaylik:</b> Hozirdanoq ushbu klaviaturadan foydalanishni boshlasangiz, kelajakda operatsion tizimlarga rasmiy yangilanish (update) kelganida qayta koʻnikish shart boʻlmaydi va terishga tayyor boʻlasiz.</li>
            <li><b>Ergonomik joylashuv:</b> Oʻzbek tilida tez-tez ishlatiladigan <b>Ş</b> va <b>Ö</b> harflari barmoqlar yetib borishi eng qulay boʻlgan markaziy oʻrinlarga joylashtirilgan. Kamroq uchraydigan <b>Ğ</b> harfi esa chetroqqa surilgan. Bu matnni tezroq va barmoqlarni toalmasdan terish imkonini beradi.</li>
          </ul>

          <p class="text-sm text-base-content/80">
            Qisqasi, <i>kiritish.uz</i> saytidagi klaviatura rasmiy standartlar kelajagiga va oʻzbek tili ergonomikasiga toʻliq mos keladi!
          </p>
        `,
  },
  {
    q: "Nimaga veb-sayt eski alifboda yozilgan?",
    a: "Google, Yandex va boshqa qidiruv tizimlarida yaxshiroq indeksatsiya qilinishi uchun va qidirish osonroq boʻlishi uchun.",
  },
];
---

<Layout>
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-center p-4 gap-4">
    <h1 class="text-2xl">
      Yangi oʻzbek alifbosi uchun klaviaturani yuklab oling
    </h1>
    <p class="md:text-xl">
      Kompyuter va telefoningizda <b>Ş, Ç, Ö, Ğ</b> harflarini qulay kiritish
      uchun klaviaturani yuklab oling. Sizni qiziqtirayotgan platformani
      tanlang:
    </p>

    <div class="grid grid-flow-col grid-cols-2 grid-rows-3 p-4 gap-4 md:grid-flow-row md:grid-cols-3 md:grid-rows-none">
      {cards.map((card, i) => (
        <a
          href={card.link}
          class="card bg-base-200 flex aspect-square w-full items-center justify-center shadow-sm hover:bg-base-300 transition-colors"
        >
          <figure class="flex-1 px-10 pt-10 p-4 flex items-center justify-center w-full fill-current text-base-content [&>svg]:w-5/6 [&>svg]:h-auto [&>svg]:max-h-24">
            <Fragment set:html={card.logo} />
          </figure>
          <div class="flex-none card-body p-4 md:p-8 link-primary text-center md:text-xl">
            {card.text}
          </div>
        </a>
      ))}
    </div>

    <!-- FAQ Section -->
    <div class="w-full max-w-3xl mt-8 space-y-4">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold md:text-3xl">
          Tez-tez soʻraladigan savollar
        </h2>
        <p class="text-sm text-base-content/70 mt-1">
          Klaviaturadan foydalanish va oʻrnatish boʻyicha ommabop savollarga
          javoblar
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-base-200 rounded-xl overflow-hidden transition-colors border border-base-300/50 [&[open]]:bg-base-200/80">
            <summary class="flex items-center justify-between p-4 md:p-5 font-semibold text-lg cursor-pointer list-none select-none hover:text-primary transition-colors">
              <span>{faq.q}</span>
              <svg
                class="w-5 h-5 shrink-0 ml-2 transition-transform duration-200 group-open:rotate-180 opacity-60"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>
            <div class="px-4 pb-5 md:px-5 text-base-content/80 leading-relaxed text-sm md:text-base border-t border-base-300/30 pt-4">
              {faq.a_html ? <Fragment set:html={faq.a_html} /> : <p>{faq.a}</p>}
            </div>
          </details>
        ))}
      </div>

      <!-- Contact Footer inside FAQ -->
      <div class="bg-base-200/50 rounded-xl p-6 text-center border border-base-300/40 mt-6">
        <h3 class="font-semibold text-lg mb-1">
          Veb-sayt muallifi bilan qanday bogʻlansam boʻladi?
        </h3>
        <p class="text-sm text-base-content/80">
          Murojaat va savollar uchun Telegram botga yozing:{" "}
          <a
            href="https://t.me/kiritishuzbot"
            target="_blank"
            rel="noopener noreferrer"
            class="link link-primary font-medium inline-flex items-center gap-1 hover:underline"
          >
            @kiritishuzbot
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
