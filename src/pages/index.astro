---
import Layout from "../layouts/Layout.astro";
import windowsLogo from "../assets/windows11.svg?raw";
import androidLogo from "../assets/android.svg?raw";
import linuxLogo from "../assets/linux-mono.svg?raw";
import samsungLogo from "../assets/samsung.svg?raw";
import macosLogo from "../assets/macos.svg?raw";
import iosLogo from "../assets/iphone.svg?raw";

const cards = [
  { logo: androidLogo, text: "Android", link: "/android/" },
  { logo: samsungLogo, text: "Samsung", link: "/samsung/" },
  { logo: iosLogo, text: "iPhone", link: "/iphone/" },
  { logo: windowsLogo, text: "Windows", link: "/windows/" },
  { logo: linuxLogo, text: "Linux", link: "/linux/" },
  { logo: macosLogo, text: "macOS", link: "/macos/" },
];

const faqs = [
  {
    q: "Redmi, Xiaomi, LG va boşqa telefonlarda yangi harflarni qanday kiritaman?",
    a: `Iltimos, <a href="/android/" class="link link-primary">Android uçun qöllanmaga</a> murojaat qiling.`,
  },
  {
    q: "Telefon uçun yuklaş uçun klaviatura fayli yöq-ku!",
    a: `
          <p class="mb-3"><b>Ha, toʻgʻri.</b> Hozirça smartfonlar (Android va iOS) uçun alohida ilova yoki fayl körinişidagi özbekça klaviatura işlab çiqilmagan. Lekin yangi harflarni kiritişning juda oson yöli bor:</p>

          <div class="bg-base-300/50 p-3.5 rounded-lg border-l-4 border-primary mb-3 text-sm md:text-base">
            <b>Qanday yoziladi?</b> Telefoningizdagi standart klaviaturada <b>S, C, O, G</b> tugmalarini bir soniya bosib tursangiz, ustida mos ravişda <b>Ş, Ç, Ö, Ğ</b> harflari çiqadi. Ulardan keraklisini tanlasangiz bas.
          </div>

          <div class="bg-warning/10 text-warning-content p-3.5 rounded-lg border border-warning/30 text-sm">
            <p class="font-semibold mb-1 flex items-center gap-1.5">
              ⚠️ Muhim xavfsizlik ogohlantirishi:
            </p>
            <p>Telegram yoki turli saytlarda tarqalayotgan nomaʼlum <b>.APK</b> fayllarni telefoningizga örnatmang! Firibgarlar bunday fayllar içiga maxfiy maʼlumotlar va parollarni öğirlovçi zararli dasturlarni joylaştirgan bölişi mumkin. Ogoh böling.</p>
          </div>
        `,
  },
  {
    q: "Buning örniga Turkça yoki Ozarbayjonça klaviatura işlatsam böladi-ku! Bu nega yomon ğoya?",
    a: `
          <p class="mb-3">Turkça va Ozarbayjonça klaviaturalarda rostdan ham <b>Ş, Ç, Ö, Ğ</b> harflari bor, lekin ulardan foydalaniş juda katta muammolarni keltirib çiqaradi:</p>
          <ul class="list-disc list-inside space-y-2 mb-3 pl-1">
            <li><b>Nuqtali va nuqtasiz "I" muammosi:</b> Turk va ozarbayjon alifbosida ikkita har xil I harfi bor: nuqtali <code>İ / i</code> hamda nuqtasiz <code>I / ı</code>. Özbek tilida esa oddiy <code>I / i</code> işlatiladi. Turkça klaviaturada yozsangiz, matningizda özbek tiliga mos kelmaydigan <i>"İkki"</i> yoki <i>"qış"</i> kabi sözlar paydo böladi.</li>
            <li><b>Qidiruv tizimlari (SEO) xatoliklari:</b> Kompyuter uçun bu harflarning raqamli kodi (Unicode) mutlaqo boşqa. Turkça klaviaturada yozilgan matnlarni Google, Telegram va qidiruv tizimlari özbekça söz deb topa olmaydi.</li>
            <li><b>Hujjatlar va dasturlaş:</b> Rasmiy davlat tizimlari (pasport, bank, soliq) turkça <code>İ</code> va <code>ı</code> harflarini nomaʼlum belgi yoki xatolik deb qabul qiladi.</li>
          </ul>
          <p>Şuning uçun turkça yoki ozarbayjonça emas, aynan özbek tili uçun moslaştirilgan klaviatura terilmasidan foydalaniş zarur.</p>
        `,
  },
  {
    q: "Bu programma xavfsizmi?",
    a: `
          <p class="mb-3">Ha, veb-saytdan klaviatura fayllarini yuklab oliş <b>100% xavfsiz</b>. Buning bir nechta asosiy sabablari bor:</p>
          <ul class="list-disc list-inside space-y-2 mb-3 pl-1">
            <li><b>Oçiq kod (Open Source):</b> Veb-sayt va klaviatura fayllarining barça kodlari <a href="https://github.com" target="_blank" class="link link-primary">GitHub</a> saytida oçiq joylangan. Xohlagan kişi kodlarni tekşirib çiqişi mumkin — u yerda hech qanday maxfiy maʼlumotlarni yiğuvchi zararli kodlar yöq.</li>
            <li><b>Rasmiy vositalardan foydalanilgan:</b> Klaviatura fayllari Windows uçun rasmiy <i>Microsoft Keyboard Layout Creator (MSKLC)</i> va macOS uçun <i>Ukelele</i> dasturlari yordamida yaratilgan. Ular tizimga heç qanday begona dastur örnatmaydi, faqatgina tugmalarning joylaşuv tartibini belgilaydi.</li>
            <li><b>Har kim özi tekşira oladi:</b> Agar şunda ham xavotiringiz bölsa, tayyor faylni yuklamasdan, uşbu rasmiy dasturlar (MSKLC/Ukelele) orqali özingiz ham 5 daqiqada xuddi şunday klaviatura terilmasini yasab olişingiz mumkin.</li>
          </ul>
        `,
  },
  {
    q: "Yangi alifbo rasman qabul qilindimi?",
    a: `
          <p class="mb-3"><b>Ha, rasman qabul qilingan.</b> Özbekiston Respublikasi Prezidenti Ş. Mirziyoyev 2026-yil 21-oktyabr kuni yangi alifbo haqidagi tuzatişlar kiritilgan qonunni imzoladi.</p>

          <div class="bg-base-300/50 p-3.5 rounded-lg border-l-4 border-primary mb-3 text-sm md:text-base">
            <b>Qaçondan kuçga kiradi?</b> Qonun rasman eʼlon qilinganidan söng <b>6 oy ötgach, 22-aprel kuni,</b> töliq kuçga kiradi.
          </div>

          <p class="text-sm text-base-content/80">
            Hozirda davlat idoralari, taʼlim muassasalari va raqamli platformalar bosqiçma-bosqiç uşbu yangi alifboga ötish işlarini olib bormoqda. Kompyuter va telefonlarda uşbu klaviatura terilmalarini hozirdanoq örnatib oliş yangi harflarga könikiş va qulay yoziş imkonini beradi.
          </p>
        `,
  },
  {
    q: "Yangi harflar nimaga aynan uşbu joyda joylaşgan?",
    a: `
          <p class="mb-3">Bu klaviatura terilmasi (layout) tasodifiy tuzilmagan — u <b>ergonomika</b>, <b>amaliy qulaylik</b> va <b>xalqaro standartlar</b> asosida işlab çiqilgan:</p>

          <ul class="list-disc list-inside space-y-2 mb-3 pl-1">
            <li><b>Rasmiy taklifga asoslangan:</b> Uşbu terilma Microsoft, Google, Apple va Linux kabi yirik texnologik kompaniyalarga operatsion tizimlariga rasmiy kiritiş uçun yuborilgan standart taklif asosida yaratilgan.</li>
            <li><b>Kelajak uçun qulaylik:</b> Hozirdanoq uşbu klaviaturadan foydalanişni boşlasangiz, kelajakda operatsion tizimlarga rasmiy yangilaniş kelganida qayta könikiş şart bölmaydi va terişga tayyor bölasiz.</li>
            <li><b>Ergonomik joylaşuv:</b> Özbek tilida tez-tez işlatiladigan <b>Ş</b> va <b>Ö</b> harflari barmoqlar yetib borişi eng qulay bölgan markaziy örinlarga joylaştirilgan. Kamroq uçraydigan <b>Ğ</b> harfi esa çetroqqa surilgan. Bu matnni tezroq va barmoqlar tolimasdan teriş imkonini beradi.</li>
          </ul>

          <p class="text-sm text-base-content/80">
            Qisqasi, <i>kiritish.uz</i> saytidagi klaviatura rasmiy standartlar kelajagiga va özbek tili ergonomikasiga töliq mos keladi!
          </p>
        `,
  },
];
---

<Layout>
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-center px-4 py-10 md:py-16 gap-8">
    <!-- Hero Section -->
    <div class="text-center max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs md:text-sm font-semibold tracking-wide">
        <span>✨ Yangi Alifbo Standarti</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight">
        Yangi özbek alifbosi uçun klaviaturani yuklab oling
      </h1>
      <p class="text-base md:text-xl text-base-content/80 leading-relaxed max-w-2xl mx-auto">
        Kompyuter va telefoningizda{" "}
        <strong class="text-base-content font-semibold">Ş, Ç, Ö, Ğ</strong>{" "}
        harflarini qulay kiritiş uçun platformangizni tanlang:
      </p>
    </div>

    <!-- Platform Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 w-full max-w-4xl my-4">
      {cards.map((card) => (
        <a
          href={card.link}
          class="card bg-base-200/70 hover:bg-base-200 border border-base-300/60 flex aspect-square w-full items-center justify-center shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 rounded-2xl p-4 group"
        >
          <figure class="flex-1 pt-4 flex items-center justify-center w-full fill-current text-base-content group-hover:scale-105 transition-transform duration-300 [&>svg]:w-3/4 [&>svg]:h-auto [&>svg]:max-h-20">
            <Fragment set:html={card.logo} />
          </figure>
          <div class="flex-none card-body p-2 md:p-4 text-center font-semibold text-primary md:text-xl">
            {card.text}
          </div>
        </a>
      ))}
    </div>

    <!-- FAQ Section Container -->
    <div class="w-full max-w-3xl mt-12 space-y-6">
      <div class="text-center space-y-2">
        <h2 class="text-2xl md:text-3xl font-bold">
          Tez-tez söraladigan savollar
        </h2>
        <p class="text-sm md:text-base text-base-content/70">
          Klaviaturadan foydalaniş va örnatiş böyiça ommabop savollarga javoblar
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-base-200/60 rounded-2xl overflow-hidden transition-all duration-200 border border-base-300/50 hover:border-primary/30 [&[open]]:bg-base-200 [&[open]]:shadow-md">
            <summary class="flex items-center justify-between p-4 md:p-5 font-semibold text-base md:text-lg cursor-pointer list-none select-none hover:text-primary transition-colors">
              <span>{faq.q}</span>
              <svg
                class="w-5 h-5 shrink-0 ml-3 transition-transform duration-200 group-open:rotate-180 opacity-60 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>
            <div class="px-4 pb-5 md:px-5 text-base-content/80 leading-relaxed text-sm md:text-base border-t border-base-300/30 pt-4">
              <Fragment set:html={faq.a} />
            </div>
          </details>
        ))}
      </div>

      <!-- Contact Footer Box -->
      <div class="bg-base-200/40 rounded-2xl p-6 md:p-8 text-center border border-base-300/50 mt-8 shadow-sm">
        <h3 class="font-bold text-lg md:text-xl mb-2">
          Veb-sayt muallifi bilan qanday boğlansam böladi?
        </h3>
        <p class="text-sm md:text-base text-base-content/80 mb-4">
          Murojaat va savollar uçun Telegram botimizga yozişingiz mumkin:
        </p>
        <a
          href="https://t.me/kiritishuzbot"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-sm md:btn-md gap-2 rounded-xl font-medium shadow-md"
        >
          <span>@kiritishuzbotʼga yoziş</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
