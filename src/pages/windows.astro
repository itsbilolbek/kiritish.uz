---
import Layout from "../layouts/Layout.astro";
import { Download, ShieldAlert, CheckCircle2 } from "@lucide/astro";
import { Image } from "astro:assets";
import windowsLayout from "../assets/windows-keyboard-layout.png";
import windowsLanguageSelect from "../assets/windows-language-select.png";
import msDefender1 from "../assets/ms-defender-1.png";
import msDefender2 from "../assets/ms-defender-2.png";
---

<Layout
  title="Windows uchun yangi oʻzbek alifbo klaviaturasini yuklab olish | Ş, Ç, Ö va Ğ harflarini kiritish"
  description="Windows operatsion tizimida yangi alifbodagi Ş, Ç, Ö va Ğ harflarini kiritish uchun klaviaturani yuklab oling."
>
  <div class="mx-auto flex max-w-5xl flex-col items-center px-4 py-10 md:py-16 gap-10">
    <!-- Hero Header & Preview -->
    <div class="text-center max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs md:text-sm font-semibold tracking-wide">
        <span>🪟 Windows 10 & 11</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight">
        Windows uchun klaviatura
      </h1>
      <p class="text-base md:text-lg text-base-content/80 leading-relaxed">
        Windows operatsion tizimida{" "}
        <strong class="text-base-content font-semibold">Ş, Ç, Ö, Ğ</strong>{" "}
        harflarini qulay va tez kiritish uchun tayyor klaviatura terilmasi.
      </p>
    </div>

    <!-- Keyboard Layout Image & Primary Download Button -->
    <div class="w-full bg-base-200/50 border border-base-300/60 rounded-3xl p-6 md:p-8 flex flex-col items-center shadow-xs gap-6">
      <Image
        src={windowsLayout}
        alt="Windows klaviatura terilmasi"
        class="rounded-xl shadow-md max-w-full h-auto zoomable-img cursor-zoom-in hover:opacity-95 transition-opacity"
      />

      <a
        class="btn btn-lg btn-primary btn-wide rounded-2xl gap-2 shadow-md hover:shadow-lg transition-all"
        href="/new-uzb.zip"
        download="new-uzb.zip"
      >
        <Download class="h-6 w-6" />
        <span>Yuklab olish (.ZIP)</span>
      </a>
    </div>

    <!-- Features Overview Section -->
    <div class="w-full space-y-4">
      <h2 class="text-2xl font-bold text-center md:text-left">
        Klaviatura xususiyatlari
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-base-200/50 border border-base-300/60 p-5 rounded-2xl space-y-2">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
            <CheckCircle2 class="w-5 h-5" />
          </div>
          <h3 class="font-semibold text-lg">Rasmiy MSKLC</h3>
          <p class="text-sm text-base-content/70 leading-relaxed">
            Microsoft’ning rasmiy{" "}
            <a
              href="https://www.microsoft.com/en-us/download/details.aspx?id=102134"
              target="_blank"
              class="link link-primary font-medium"
            >
              MSKLC
            </a>{" "}
            dasturida yaratilgan. Kodlari{" "}
            <a
              href="https://github.com/itsbilolbek/kiritish.uz"
              target="_blank"
              class="link link-primary font-medium"
            >
              GitHub
            </a>
            ’da ochiq.
          </p>
        </div>

        <div class="bg-base-200/50 border border-base-300/60 p-5 rounded-2xl space-y-2">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
            <kbd class="kbd kbd-sm">“ ”</kbd>
          </div>
          <h3 class="font-semibold text-lg">Tipografik belgilar</h3>
          <p class="text-sm text-base-content/70 leading-relaxed">
            Matn yozishni qulaylashtirish uchun qoʻshtirnoqlar, en-dash (–) va
            em-dash (—) qoʻshilgan.
          </p>
        </div>

        <div class="bg-base-200/50 border border-base-300/60 p-5 rounded-2xl space-y-2">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
            🇺🇿
          </div>
          <h3 class="font-semibold text-lg">Rasmiy standart</h3>
          <p class="text-sm text-base-content/70 leading-relaxed">
            Yirik texnologik kompaniyalarga rasmiy taklif sifatida yuborilgan.
            Tez orada operatsion tizimlarga rasmiy kiritiladi.
          </p>
        </div>
      </div>
    </div>

    <!-- Key Shortcuts & Combinations Section -->
    <div class="w-full space-y-6">
      <h2 class="text-2xl font-bold text-center md:text-left">
        Tugmalar birikmasi
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Direct Characters Table -->
        <div class="bg-base-200/40 border border-base-300/60 rounded-2xl p-5 space-y-3">
          <h3 class="font-semibold text-lg text-primary flex items-center gap-2">
            <span>🔤 Yangi harflar va belgilar</span>
          </h3>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Natija</th>
                  <th>Bosiladigan tugma</th>
                </tr>
              </thead>
              <tbody class="text-sm">
                <tr>
                  <td>
                    <b>ş / Ş</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">;</kbd> /{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">;</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>ç / Ç</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">'</kbd> /{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">'</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>ö / Ö</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">[</kbd> /{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">[</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>ğ / Ğ</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">]</kbd> /{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">]</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>Tutuq belgisi (ʼ)</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">`</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>ASCII qoʻshtirnoq (")</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">`</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>Nuqta vergul (;)</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">\</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    <b>Ikki nuqta (:)</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">\</kbd>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Typography & AltGr Symbols Table -->
        <div class="bg-base-200/40 border border-base-300/60 rounded-2xl p-5 space-y-3">
          <h3 class="font-semibold text-lg text-primary flex items-center gap-2">
            <span>✨ Tipografik belgilar va qavslar</span>
          </h3>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Belgi</th>
                  <th>Kombinatsiya (AltGr)</th>
                </tr>
              </thead>
              <tbody class="text-sm">
                <tr>
                  <td>Qoʻshtirnoq “ va ”</td>
                  <td>
                    <kbd class="kbd kbd-sm">AltGr</kbd> +{" "}
                    <kbd class="kbd kbd-sm">K</kbd> va{" "}
                    <kbd class="kbd kbd-sm">AltGr</kbd> +{" "}
                    <kbd class="kbd kbd-sm">L</kbd>
                  </td>
                </tr>
                <tr>
                  <td>Birtirnoq ‘ va ’</td>
                  <td>
                    <kbd class="kbd kbd-sm">AltGr</kbd> +{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">K</kbd> va
                    <br />
                    <kbd class="kbd kbd-sm">AltGr</kbd> +{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">L</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    Em dash <small>(—)</small>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">AltGr</kbd> +{" "}
                    <kbd class="kbd kbd-sm">-</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    En dash <small>(–)</small>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">AltGr</kbd> +{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">-</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    Qavslar <b>[</b> va <b>]</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">AltGr</kbd> +{" "}
                    <kbd class="kbd kbd-sm">[</kbd> yoki{" "}
                    <kbd class="kbd kbd-sm">]</kbd>
                  </td>
                </tr>
                <tr>
                  <td>
                    Figurali qavslar <b>&#123;</b> va <b>&#125;</b>
                  </td>
                  <td>
                    <kbd class="kbd kbd-sm">AltGr</kbd> +{" "}
                    <kbd class="kbd kbd-sm">Shift</kbd> +{" "}
                    <kbd class="kbd kbd-sm">[</kbd> yoki{" "}
                    <kbd class="kbd kbd-sm">]</kbd>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Installation Steps Section -->
    <div class="w-full bg-base-200/40 border border-base-300/60 rounded-3xl p-6 md:p-8 space-y-6 shadow-xs">
      <h2 class="text-2xl font-bold text-center md:text-left">
        Oʻrnatish yoʻriqnomasi
      </h2>

      <ol class="space-y-6">
        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            1
          </span>
          <div class="space-y-1">
            <h3 class="font-semibold text-base md:text-lg">
              Faylni yuklab oling
            </h3>
            <p class="text-sm text-base-content/80">
              <a
                href="/new-uzb.zip"
                download="new-uzb.zip"
                class="link link-primary font-mono font-semibold"
              >
                new-uzb.zip
              </a>{" "}
              arxiv faylini kompyuteringizga yuklab oling.
            </p>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            2
          </span>
          <div class="space-y-1">
            <h3 class="font-semibold text-base md:text-lg">
              Arxivdan chiqaring
            </h3>
            <p class="text-sm text-base-content/80">
              Yuklab olingan zip faylni istalgan papkaga arxivdan chiqaring
              (Extract).
            </p>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            3
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Oʻrnatuvchini (setup.exe) ishga tushiring
            </h3>
            <p class="text-sm text-base-content/80">
              <code class="font-mono bg-base-300/60 px-2 py-0.5 rounded text-xs">
                setup.exe
              </code>{" "}
              faylini oching va klaviatura terilmasini oʻrnating.
            </p>

            <!-- Defender Warning Callout Card -->
            <div class="bg-warning/10 text-warning-content border border-warning/30 rounded-2xl p-4 md:p-5 space-y-3">
              <div class="flex items-center gap-2 font-bold text-sm md:text-base">
                <ShieldAlert class="w-5 h-5 text-warning shrink-0" />
                <span>Windows Defender SmartScreen xabari haqida:</span>
              </div>
              <p class="text-xs md:text-sm leading-relaxed opacity-90">
                Oʻrnatish vaqtida koʻk rangli xavfsizlik oynasi chiqsa,{" "}
                <b>Qoʻshimcha maʼlumot (More info)</b> tugmasini va soʻngra{" "}
                <b>Baribir ishga tushirilsin (Run anyway)</b> tugmasini bosing.
                Bu fayllar tijorat (pullik) sertifikatiga ega boʻlmagani uchun
                Windows tomonidan chiqariladigan odatiy holat. Loyihaning barcha
                ochiq manba kodlarini{" "}
                <a
                  href="https://github.com/itsbilolbek/kiritish.uz"
                  target="_blank"
                  class="link underline font-semibold"
                >
                  GitHub sahifamizda
                </a>{" "}
                koʻrib chiqishingiz mumkin.
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                <Image
                  src={msDefender1}
                  alt="Microsoft Defender Warning - Step 1"
                  class="rounded-xl border border-warning/20 w-full h-auto object-contain shadow-xs zoomable-img cursor-zoom-in hover:opacity-95 transition-opacity"
                />
                <Image
                  src={msDefender2}
                  alt="Microsoft Defender Warning - Step 2"
                  class="rounded-xl border border-warning/20 w-full h-auto object-contain shadow-xs zoomable-img cursor-zoom-in hover:opacity-95 transition-opacity"
                />
              </div>
            </div>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            4
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Klaviaturani tanlang
            </h3>
            <p class="text-sm text-base-content/80">
              Kompyuterni qayta ishga tushiring (restart) va Windows til paneli
              (ekranning pastki oʻng burchagida) orqali <b>Özbekça - yangi</b>{" "}
              terilmasini tanlang.
            </p>

            <div class="flex justify-center pt-2">
              <Image
                src={windowsLanguageSelect}
                alt="Windows til tanlash menyusi"
                class="rounded-xl border border-base-300 shadow-sm max-w-md w-full zoomable-img cursor-zoom-in hover:opacity-95 transition-opacity"
              />
            </div>
          </div>
        </li>
      </ol>
    </div>

    <!-- Bottom Secondary Download Callout -->
    <div class="text-center pt-4">
      <a
        class="btn btn-lg btn-primary btn-wide rounded-2xl gap-2 shadow-md hover:shadow-lg transition-all"
        href="/new-uzb.zip"
        download="new-uzb.zip"
      >
        <Download class="h-6 w-6" />
        <span>Yuklab olish (.ZIP)</span>
      </a>
    </div>
  </div>
</Layout>
