---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import gboardS from "../assets/gboard-ş.png";
import gboardO from "../assets/gboard-ö.png";
import gboardC from "../assets/gboard-ç.png";
import gboardG from "../assets/gboard-ğ.png";
import gboardSettings1 from "../assets/gboard-1.png";
import gboardSettings2 from "../assets/gboard-2.png";
import gboardSettings3 from "../assets/gboard-3.png";
import gboardSettings4 from "../assets/gboard-4.png";
---

<Layout
  title="Gboard klaviaturasi | Yangi alifbodagi Ş, Ç, Ö va Ğ harflarini kiritish"
  description="Android operatsion tizimida yangi alifbodagi Ş, Ç, Ö va Ğ harflarini Gboard klaviaturasi yordamida kiriting."
>
  <div class="mx-auto flex max-w-5xl flex-col items-center px-4 py-10 md:py-16 gap-10">
    <!-- Hero Header -->
    <div class="text-center max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs md:text-sm font-semibold tracking-wide">
        <span>🤖 Android / Gboard Keyboard</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight">
        Gboard klaviaturasi
      </h1>
      <p class="text-base md:text-lg text-base-content/80 leading-relaxed">
        Android qurilmalarida{" "}
        <strong class="text-base-content font-semibold">Ş, Ö, Ç va Ğ</strong>{" "}
        harflarini kiritiş uçun{" "}
        <a
          href="https://play.google.com/store/apps/details?id=com.google.android.inputmethod.latin"
          target="_blank"
          class="link link-primary font-medium"
        >
          Gboard
        </a>{" "}
        klaviaturasida Özbek tilini sozlaşingiz kifoya.
      </p>
    </div>

    <!-- Installation Steps Section -->
    <div class="w-full bg-base-200/40 border border-base-300/60 rounded-3xl p-6 md:p-8 space-y-6 shadow-xs">
      <h2 class="text-2xl font-bold text-center md:text-left">
        Örnatiş va sozlaş usuli
      </h2>

      <ol class="space-y-8">
        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            1
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Gboard sozlamalarini oçing
            </h3>
            <p class="text-sm text-base-content/80">
              Gboard sozlamalariga kiring va <b>Tillar (Languages)</b> bölimiga
              öting.
            </p>
            <div class="flex justify-center pt-2">
              <Image
                src={gboardSettings1}
                alt="Gboard klaviaturasi: bosh menyu"
                class="rounded-xl border border-base-300 shadow-sm max-w-xs w-full"
              />
            </div>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            2
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">Klaviatura qöşiş</h3>
            <p class="text-sm text-base-content/80">
              <b>Klaviatura qöşiş (Add keyboard)</b> tugmasini bosing va
              röyxatdan <b>Oʻzbek (lotin)</b> opsiyasini tanlang.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
              <div class="flex justify-center">
                <Image
                  src={gboardSettings2}
                  alt="Gboard klaviaturasi: tillar menyusi"
                  class="rounded-xl border border-base-300 shadow-sm max-w-xs w-full"
                />
              </div>
              <div class="flex justify-center">
                <Image
                  src={gboardSettings3}
                  alt="Gboard klaviaturasi: klaviatura qoʻshish menyusi"
                  class="rounded-xl border border-base-300 shadow-sm max-w-xs w-full"
                />
              </div>
            </div>
          </div>
        </li>

        <li class="flex items-start gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary text-primary-content font-bold shrink-0">
            3
          </span>
          <div class="space-y-3 w-full">
            <h3 class="font-semibold text-base md:text-lg">
              Sozlamani yakunlang
            </h3>
            <p class="text-sm text-base-content/80">
              <b>Tayyor (Done)</b> tugmasini bosing. Şundan söng yangi alifbo
              harflari klaviaturangizda faollaşadi.
            </p>
            <div class="flex justify-center pt-2">
              <Image
                src={gboardSettings4}
                alt="Gboard klaviaturasi: Oʻzbek (lotin) menyusi"
                class="rounded-xl border border-base-300 shadow-sm max-w-xs w-full"
              />
            </div>
          </div>
        </li>
      </ol>
    </div>

    <!-- How to Type Section (Cards Grid) -->
    <div class="w-full max-w-3xl space-y-6">
      <h2 class="text-2xl font-bold text-center">
        Harflarni qanday kiritiş mumkin?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-base-200/50 p-5 rounded-2xl border border-base-300/60 flex items-start gap-4 shadow-xs">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary/10 text-primary font-bold text-lg shrink-0">
            Ş
          </span>
          <div>
            <h3 class="font-semibold text-base">Ş harfi</h3>
            <p class="text-sm text-base-content/70 mt-1">
              <kbd class="kbd kbd-sm">S</kbd> tugmasini bosib turing va çiqqan
              oynadan Ş harfini tanlang.
            </p>
          </div>
        </div>

        <div class="bg-base-200/50 p-5 rounded-2xl border border-base-300/60 flex items-start gap-4 shadow-xs">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary/10 text-primary font-bold text-lg shrink-0">
            Ö
          </span>
          <div>
            <h3 class="font-semibold text-base">Ö harfi</h3>
            <p class="text-sm text-base-content/70 mt-1">
              <kbd class="kbd kbd-sm">O</kbd> tugmasini bosib turing va çiqqan
              oynadan Ö harfini tanlang.
            </p>
          </div>
        </div>

        <div class="bg-base-200/50 p-5 rounded-2xl border border-base-300/60 flex items-start gap-4 shadow-xs">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary/10 text-primary font-bold text-lg shrink-0">
            Ç
          </span>
          <div>
            <h3 class="font-semibold text-base">Ç harfi</h3>
            <p class="text-sm text-base-content/70 mt-1">
              <kbd class="kbd kbd-sm">C</kbd> tugmasini bosib turing va çiqqan
              oynadan Ç harfini tanlang.
            </p>
          </div>
        </div>

        <div class="bg-base-200/50 p-5 rounded-2xl border border-base-300/60 flex items-start gap-4 shadow-xs">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary/10 text-primary font-bold text-lg shrink-0">
            Ğ
          </span>
          <div>
            <h3 class="font-semibold text-base">Ğ harfi</h3>
            <p class="text-sm text-base-content/70 mt-1">
              <kbd class="kbd kbd-sm">G</kbd> tugmasini bosib turing va çiqqan
              oynadan Ğ harfini tanlang.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
