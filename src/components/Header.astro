---
import { Menu } from "@lucide/astro";
import { Image } from "astro:assets";
import githubLogo from "../assets/github.svg";
import githubDarkLogo from "../assets/github-dark.svg";
---

<div class="navbar bg-base-100 shadow-sm">
  <div class="navbar-start">
    <a href="/" class="btn btn-ghost text-xl">
      kiritish.uz
    </a>
  </div>
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal">
      <li>
        <a href="/samsung/" class="btn btn-ghost text-xl">
          Samsung
        </a>
      </li>
      <li>
        <a href="/android/" class="btn btn-ghost text-xl">
          Android
        </a>
      </li>
      <li>
        <a href="/iphone/" class="btn btn-ghost text-xl">
          iPhone
        </a>
      </li>
      <li>
        <a href="/windows/" class="btn btn-ghost text-xl">
          Windows
        </a>
      </li>
      <li>
        <a href="/macos/" class="btn btn-ghost text-xl">
          MacOS
        </a>
      </li>
      <li>
        <a href="/linux/" class="btn btn-ghost text-xl">
          Linux
        </a>
      </li>
      <li>
        <a href="/donate/" class="btn btn-ghost text-xl text-amber-500">
          Donat qilish
        </a>
      </li>
    </ul>
  </div>
  <div class="navbar-end">
    <a
      href="https://github.com/itsbilolbek/kiritish.uz"
      class="block dark:hidden p-4"
    >
      <Image src={githubLogo} alt="GitHub Logo" width={32} />
    </a>
    <a
      href="https://github.com/itsbilolbek/kiritish.uz"
      class="hidden dark:block p-4"
    >
      <Image src={githubDarkLogo} alt="GitHub Logo" width={32} />
    </a>
    <details class="dropdown dropdown-end">
      <summary role="button" class="btn btn-ghost lg:hidden">
        <Menu />
      </summary>
      <ul class="menu menu-sm menu-vertical dropdown-content rounded-box bg-base-100 z-30 mt-4 p-2 shadow">
        <li>
          <a href="/samsung/" class="btn btn-ghost text-xl">
            Samsung
          </a>
        </li>
        <li>
          <a href="/android/" class="btn btn-ghost text-xl">
            Android
          </a>
        </li>
        <li>
          <a href="/iphone/" class="btn btn-ghost text-xl">
            iPhone
          </a>
        </li>
        <li>
          <a href="/windows/" class="btn btn-ghost text-xl">
            Windows
          </a>
        </li>
        <li>
          <a href="/macos/" class="btn btn-ghost text-xl">
            MacOS
          </a>
        </li>
        <li>
          <a href="/linux/" class="btn btn-ghost text-xl">
            Linux
          </a>
        </li>
        <li>
          <a href="/donate/" class="btn btn-ghost text-xl">
            Donat qilish
          </a>
        </li>
      </ul>
    </details>
  </div>
</div>
