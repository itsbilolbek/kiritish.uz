---
import { Menu } from "@lucide/astro";
import { Image } from "astro:assets";
import githubLogo from "../assets/github.svg";
---

<div class="navbar bg-base-100 shadow-sm">
  <div class="navbar-start">
    <a href="/" class="btn btn-ghost text-xl">
      kiritish.uz
    </a>
  </div>
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal">
      <li>
        <a href="/samsung-guide" class="btn btn-ghost text-xl">
          Samsung
        </a>
      </li>
      <li>
        <a href="/android-guide" class="btn btn-ghost text-xl">
          Android
        </a>
      </li>
      <li>
        <a href="/ios-guide" class="btn btn-ghost text-xl">
          iOS
        </a>
      </li>
      <li>
        <a href="/windows-guide" class="btn btn-ghost text-xl">
          Windows
        </a>
      </li>
      <li>
        <a href="/macos-guide" class="btn btn-ghost text-xl">
          MacOS
        </a>
      </li>
      <li>
        <a href="/linux-guide" class="btn btn-ghost text-xl">
          Linux
        </a>
      </li>
    </ul>
  </div>
  <div class="navbar-end">
    <a href="https://github.com/itsbilolbek/kiritish.uz" class="p-4">
      <Image src={githubLogo} alt="GitHub Logo" width={32} />
    </a>
    <details class="dropdown dropdown-end">
      <summary role="button" class="btn btn-ghost lg:hidden">
        <Menu />
      </summary>
      <ul class="menu menu-sm menu-vertical dropdown-content rounded-box bg-base-100 z-30 mt-4 p-2 shadow">
        <li>
          <a href="/samsung-guide" class="btn btn-ghost text-xl">
            Samsung
          </a>
        </li>
        <li>
          <a href="/android-guide" class="btn btn-ghost text-xl">
            Android
          </a>
        </li>
        <li>
          <a href="/ios-guide" class="btn btn-ghost text-xl">
            iOS
          </a>
        </li>
        <li>
          <a href="/windows-guide" class="btn btn-ghost text-xl">
            Windows
          </a>
        </li>
        <li>
          <a href="/macos-guide" class="btn btn-ghost text-xl">
            MacOS
          </a>
        </li>
        <li>
          <a href="/linux-guide" class="btn btn-ghost text-xl">
            Linux
          </a>
        </li>
      </ul>
    </details>
  </div>
</div>
