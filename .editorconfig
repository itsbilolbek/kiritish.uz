root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.{html,css}]
indent_style = space
indent_size = 2

[*.{js,ts}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
# STRICT REQUIREMENT
indent_style = space
indent_size = 2

[*.{json,toml}]
indent_style = space
indent_size = 2

[*.nix]
indent_style = space
indent_size = 2

[justfile]
indent_style = space
indent_size = 2

[Makefile]
# STRICT REQUIREMENT
indent_style = tab
indent_size = 8

[*.go]
# STRICT REQUIREMENT: Hard tabs
indent_style = tab
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.java]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{c,cpp,h,hpp,cc,hh,cxx,hxx,inl}]
indent_style = space
indent_size = 4
