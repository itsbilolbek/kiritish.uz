{
  "format_on_save": "on",
  "formatter": {
    "external": {
      "command": "prettier",
      "arguments": ["--stdin-filepath", "{buffer_path}"]
    }
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd"],
      "formatter": {
        "external": {
          "command": "treefmt",
          "arguments": ["--stdin", "{buffer_path}"]
        }
      }
    },
    "TOML": {
      "formatter": {
        "external": {
          "command": "treefmt",
          "arguments": ["--stdin", "{buffer_path}"]
        }
      }
    }
  }
}
